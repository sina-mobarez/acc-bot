{
  "name": "acc-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acc-bot",
      // PLACEHOLDER: replace with the id printed by `wrangler d1 create acc-bot`
      "database_id": "2b6e5011-4b76-4c5a-8712-270f1d96a144",
      "migrations_dir": "migrations"
    }
  ],
  "assets": { "directory": "public", "binding": "ASSETS" },
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "GEMINI_MODEL": "gemini-3.5-flash-lite", "DEFAULT_ASSET": "USDT" }
}
