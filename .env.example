# Telegram bot token from @BotFather
BOT_TOKEN=

# Google Sheet ID (from /spreadsheets/d/<ID>/edit). Leave empty to store in the DB only.
SHEET_ID=
WORKSHEET=Deals
GOOGLE_CREDENTIALS_FILE=credentials.json

# Comma-separated Telegram user IDs allowed to approve/reject/cancel approved deals.
# Empty = any admin of the group (clients who are group admins could approve too!).
APPROVER_IDS=

TIMEZONE=Asia/Tehran
DEFAULT_ASSET=USDT
DB_PATH=deals.db

# SOCKS/HTTP proxy for Telegram, e.g. socks5h://127.0.0.1:1080 (set by docker-compose on the server)
PROXY_URL=
